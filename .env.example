# Copy this file to .env and adjust it. The helper scripts do this for you
# on the first run. Never commit .env.
#
# Values: plain text, no spaces around "=". Avoid "$" (write "$$" if you must),
# spaces and quotes in passwords; letters, digits, "-" and "_" are always safe.

# --- Odoo ------------------------------------------------------------------

# Odoo major version: 17, 18, 19 or 20. Just the number, without ".0".
# Before changing it on a running setup, run "down" first.
# Enterprise users: addons/enterprise must be on the matching branch (20 -> 20.0).
ODOO_VERSION=20

# Optional: pin an exact image build for reproducible setups. It must belong to
# ODOO_VERSION, e.g. 20.0-20260926 for ODOO_VERSION=20.
# Tags: https://hub.docker.com/_/odoo/tags
# ODOO_TAG=

# Master password for the database manager (create, backup, restore, drop).
ADMIN_PASSWORD=admin

# Default database used by the helper commands (install, update, shell...).
# Give your first database this name and you never need to type it.
ODOO_DB=odoo

# Developer mode flags for the server, e.g. xml,qweb (empty = off).
# "reload" needs file change events, which do not reach containers from Windows folders.
ODOO_DEV_MODE=

# --- PostgreSQL ------------------------------------------------------------

# 16 works with every supported Odoo version. Use 13 to 17 (the volume layout changed in 18).
POSTGRES_VERSION=16
# Only used when the database volume is first created. Changing them later
# requires "reset" (back up first).
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# --- Network ---------------------------------------------------------------

# Where Odoo listens. 127.0.0.1 keeps it private to this machine. Use 0.0.0.0
# to reach it from other devices on your network (and change ADMIN_PASSWORD).
# PostgreSQL and pgAdmin always stay on 127.0.0.1.
BIND_ADDRESS=127.0.0.1

# Change these to run several copies of this template side by side.
ODOO_PORT=8069
POSTGRES_PORT=5433
PGADMIN_PORT=5050

# --- Addons folders --------------------------------------------------------

# Paths on your machine, relative to this folder or absolute (use forward
# slashes on Windows, e.g. C:/odoo/enterprise). They must exist.
# Keep Enterprise either in addons/enterprise or outside this repository,
# so it can never be committed.
ENTERPRISE_ADDONS_PATH=./addons/enterprise
THIRD_PARTY_ADDONS_PATH=./addons/third_party
CUSTOM_ADDONS_PATH=./addons/custom

# --- Advanced --------------------------------------------------------------

# Prefix of the Docker Compose project. Containers and volumes are named
# <PROJECT_NAME>-<ODOO_VERSION>, e.g. odoo-20. Give each copy of this template
# that uses the same ODOO_VERSION its own prefix, or they share the same databases.
# PROJECT_NAME=odoo
