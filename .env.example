# Copy this file to .env and adjust it. The helper scripts do this for you
# on the first run. Never commit .env.

# --- Odoo ------------------------------------------------------------------

# Odoo major version: 17, 18, 19 or 20.
# Enterprise users: addons/enterprise must be checked out on the same branch (e.g. 20.0).
ODOO_VERSION=20

# Optional: pin an exact image build for reproducible setups, e.g. 20.0-20260926.
# Tags: https://hub.docker.com/_/odoo/tags
# ODOO_TAG=

# Master password for the database manager (create, backup, restore, drop).
ADMIN_PASSWORD=admin

# Default database used by the helper commands (install, update, shell...).
ODOO_DB=odoo

# Developer mode flags for the server, e.g. xml,qweb (empty = off).
# "reload" needs file change events, which do not reach containers from Windows folders.
ODOO_DEV_MODE=

# --- PostgreSQL ------------------------------------------------------------

# 16 works with every supported Odoo version. Use 13 to 17 (the volume layout changed in 18).
POSTGRES_VERSION=16
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# --- Network ---------------------------------------------------------------

# 127.0.0.1 keeps everything private to this machine.
# Use 0.0.0.0 to reach Odoo from other devices on your network (e.g. a phone).
BIND_ADDRESS=127.0.0.1

# Change these to run several copies of this template side by side.
ODOO_PORT=8069
POSTGRES_PORT=5433
PGADMIN_PORT=5050

# --- Addons folders --------------------------------------------------------

# Paths on your machine. Point them elsewhere to reuse an existing checkout,
# e.g. ENTERPRISE_ADDONS_PATH=../enterprise-20.0
ENTERPRISE_ADDONS_PATH=./addons/enterprise
THIRD_PARTY_ADDONS_PATH=./addons/third_party
CUSTOM_ADDONS_PATH=./addons/custom

# --- Advanced --------------------------------------------------------------

# Docker Compose project name. Defaults to odoo-<ODOO_VERSION>, which keeps one
# database volume per version. Set it to run two copies of the same version.
# PROJECT_NAME=
